# Settings for the production stack (docker-compose.prod.yml). Copy this file
# to .env and replace the placeholder values:
#
#   cp .env.example .env
#
# Docker Compose reads .env from the project root automatically. The
# development stack needs no .env: it has local defaults, which a .env
# overrides when present.
#
# This file is separate from backend/.env, which the backend process reads
# itself. Never commit .env: anything committed stays in the git history.

# --- Database ---
# Production uses a managed RDS database, not a local container.
# docker-compose.prod.yml already sets DATABASE_SSL=true, since RDS requires TLS.
DATABASE_URL=postgresql://<user>:<password>@<rds-endpoint>:5432/<db>

# Signs the session cookie. Required in production, which has no fallback.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-secret

# Used only by the development database container. Uncomment to change the
# local defaults.
# POSTGRES_USER=posthub
# POSTGRES_PASSWORD=posthub
# POSTGRES_DB=posthub

# --- S3 uploads and CloudFront reads ---
# Optional. Without them, uploads return 503 and posts show no images.
#
# Uploading needs S3_BUCKET and AWS_REGION. The EC2 instance role supplies the
# AWS credentials, so never put AWS keys in this file.
# Showing images needs S3_PUBLIC_BASE_URL, the CloudFront domain in front of
# the private bucket.
S3_BUCKET=posthub-uploads-prod
AWS_REGION=us-east-1
S3_PUBLIC_BASE_URL=https://d1234abcd.cloudfront.net
# Lifetime of a presigned upload URL, in seconds (default 300).
# UPLOAD_URL_TTL=300
