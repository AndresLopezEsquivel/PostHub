# PostHub root Compose secrets. Copy to `.env` (git-ignored) and fill in real
# values for a deployed / NODE_ENV=production run:
#
#   cp .env.example .env   # then edit
#
# Compose auto-loads `.env` from the project root for every `docker compose`
# invocation. The base docker-compose.yml falls back to the throwaway `posthub`
# dev creds when these are unset, so a local `docker compose up` needs no .env at
# all — this file matters only for docker-compose.prod.yml.
#
# NOTE: this is the ROOT Compose scope, distinct from backend/.env (which dotenv
# loads inside the Node process). Don't conflate the two. Never commit the real
# .env — git history is forever.

POSTGRES_USER=posthub
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=posthub

# Signs the session cookie. Use a long random string, e.g. `openssl rand -hex 32`.
SESSION_SECRET=replace-with-a-long-random-secret

# DATABASE_URL is NOT set here on purpose: the base compose derives it from the
# POSTGRES_* values above, so there is one source of truth and no drift risk.
